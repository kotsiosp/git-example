# Copy to .env and fill in. The app reads these at startup.

# Required to generate answers (retrieval/tests work without it).
ANTHROPIC_API_KEY=

# LLM settings (defaults shown). Use claude-sonnet-5 or claude-haiku-4-5 for
# cheaper, higher-volume production traffic.
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=2048
ENABLE_REFUSAL_FALLBACK=true

# Retrieval settings (defaults shown).
RETRIEVAL_TOP_K=4
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
