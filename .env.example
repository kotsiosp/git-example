# Copy to .env and fill in. The app reads these at startup.

# --- Claude / LLM -----------------------------------------------------------
# Required to generate answers (retrieval, PDFs, routing, and tests work without it).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5          # or claude-sonnet-5 / claude-haiku-4-5 for cheaper traffic
CLAUDE_EFFORT=medium               # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=2048
ENABLE_REFUSAL_FALLBACK=true

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=4
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40

# --- Freemium (Phase 4) -----------------------------------------------------
FREE_INQUIRIES_PER_MONTH=3

# --- Storage / runtime state ------------------------------------------------
# Defaults to ./var (sqlite db + generated PDFs). Use an encrypted EU volume in prod.
DATA_DIR=./var

# --- WhatsApp Cloud API (Phase 2) -------------------------------------------
# From Meta for Developers -> your app -> WhatsApp product.
WHATSAPP_TOKEN=                    # permanent / system-user access token
WHATSAPP_PHONE_NUMBER_ID=          # the sending phone number id
WHATSAPP_VERIFY_TOKEN=             # any string you choose; used for webhook verification
WHATSAPP_APP_SECRET=               # app secret; used to verify inbound webhook signatures
WHATSAPP_GRAPH_VERSION=v21.0
# Public HTTPS URL of THIS service (only needed if you switch to sending media by link).
PUBLIC_BASE_URL=
