# Your domain, e.g. mybets.com — point its DNS A record at the server first.
DOMAIN=example.com

# Master account (created on first start only; change the password later from the Account page).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

SITE_NAME=PlayBet
CURRENCY_NAME=credits

# Football betting is off for now (horse racing only). Set to true to turn it on.
FOOTBALL_ENABLED=false

# Live odds: get a key at https://the-odds-api.com. Leave empty to run with demo odds.
ODDS_API_KEY=
# eu = European bookmakers (Pinnacle, Bet365, William Hill, Unibet...). Also: uk, us, au.
ODDS_REGIONS=eu
# Empty = average of all bookmakers. Or pick one, e.g. pinnacle, williamhill, onexbet.
ODDS_BOOKMAKER=
LEAGUES=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_uefa_champs_league
ODDS_REFRESH_MINUTES=60
SCORES_REFRESH_MINUTES=30

# Horse racing. RACING_SOURCE=nrc reads Racing NRC (Nicosia); demo simulates races.
RACING_ENABLED=true
RACING_SOURCE=nrc
RACING_REFRESH_SECONDS=60
NRC_TRACKS=CY-NICOSIA-TH
NRC_RACE_DAYS=wed,sun
NRC_PLACES_PAID=2

MIN_STAKE=1
MAX_STAKE=10000
MAX_LEGS=12
